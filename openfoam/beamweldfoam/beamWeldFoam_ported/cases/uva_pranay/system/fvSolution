FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.phase1.*"
    {
        nAlphaCorr      3;
        nAlphaSubCycles 3;
        cAlpha          1.0;
        scAlpha         0.5;

        MULESCorr       yes;
        nLimiterIter    5;

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0;
    }

    p_rgh
    {
        solver          GAMG;
        tolerance       1e-9;
        relTol          0.0;
        minIter         1;
        smoother        GaussSeidel;
        nPreSweeps      2;
        nPostSweeps     3;
        nFinestSweeps   2;
        cacheAgglomeration on;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    p_rghFinal
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            tolerance       1e-9;
            relTol          0;
            nVcycles        5;
            smoother        GaussSeidel;
            nPreSweeps      2;
            nPostSweeps     3;
            nFinestSweeps   2;
            cacheAgglomeration on;
            nCellsInCoarsestLevel 10;
            agglomerator    faceAreaPair;
            mergeLevels     1;
        }
        tolerance       1e-9;
        relTol          0;
        minIter         1;
        maxIter         25;
    }

    pcorr
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            tolerance       1e-9;
            relTol          0;
            smoother        GaussSeidel;
        }
        tolerance       1e-9;
        relTol          0;
        maxIter         100;
    }

    pcorrFinal
    {
        $pcorr;
    }

    "pcorr.*"
    {
        $pcorr;
    }

    U
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-9;
        relTol          0.0;
        nSweeps         5;
    }

    UFinal
    {
        $U;
        tolerance       1e-9;
        relTol          0;
    }

    "U.*"
    {
        $U;
    }

    Temperature
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0.0;
    }

    TemperatureFinal
    {
        $Temperature;
    }

    "Temperature.*"
    {
        $Temperature;
    }
}

PIMPLE
{
    nOuterCorrectors 1;
    nCorrectors     3;
    nNonOrthogonalCorrectors 0;
    pRefCell        0.0;
    pRefValue       0.0;
}

MELTING
{
    minTempCorrector 1;
    maxTempCorrector 150;
    epsilonTolerance 1e-6;
    epsilonRelaxation 0.95;

    // WAAM Arc Heat Source (200 A * 24 V * 0.8 efficiency)
    HS_a            0.0035;       // Arc heat source radius [m] (3.5 mm)
    HS_bg           0.0;          // Beam gaussian offset [m] (centred at x=0)
    HS_velocity     0.010;        // Arc travel velocity [m/s] (10 mm/s along +z)
    HS_lg           -0.020;       // Start position at z=-20 mm
    HS_Q            850.0;        // Calibrated surface arc power [W]

    HS_deposition_cutoff 0.5;

    Oscillation_Amplitude   0.0;
    Oscillation_Frequency   0.0;

    Y_R             0.15;         // Focusing parameter
    focY            0.003;        // Focal Y position [m] (substrate surface at y=3 mm)
    foc_shift_vel   0.0;          // Focal shift velocity [m/s]
    Q_ramp_rate     0.0;          // Constant sustained power
    tshift          1.0;          // Ramp time threshold [s]

    damperSwitch    true;
}

relaxationFactors
{
    "U.*"           0.82;
}

