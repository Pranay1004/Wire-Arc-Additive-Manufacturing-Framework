FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.phase1 0
);

regions
(
    boxToCell
    {
        // Substrate region: y from 3mm to 13mm (10mm thick mild steel substrate)
        box (-0.020 0.003 -0.030) (0.020 0.014 0.030);
        fieldValues
        (
            volScalarFieldValue alpha.phase1 1
        );
    }
);

